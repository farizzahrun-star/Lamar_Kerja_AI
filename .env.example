# ---------------------------------------------------------------------------
# Salin menjadi `.env` (root, untuk worker) dan `apps/web/.env.local`
# (dimuat Next.js). Jangan commit nilai asli.
# ---------------------------------------------------------------------------

# Aplikasi
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase (project: ktdpqfxdnlyryvsdwnh)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Hanya untuk server (Route Handlers, Server Actions, worker). Jangan pernah
# dikirim ke browser.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Registrasi terbuka (internal). Set false untuk mode undangan.
REGISTRATION_ENABLED=true
# Daftar email admin dipisah koma untuk toggle kill switch job_sources (kosong = terbuka di dev lokal)
ADMIN_EMAILS=
APPLY_DAILY_LIMIT_PER_USER=10

# AI / Ollama (Phase 1 M3)
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=180000
CV_AI_CONSENT_VERSION=2026-11-06.v1

# Penyimpanan file lokal
DATA_DIR=./data
CV_STORAGE_DIR=./data/cv
RESUME_STORAGE_DIR=./data/resumes
CV_UPLOAD_MAX_PER_HOUR=5

# Deployment VM & Cloudflare Tunnel (opsional untuk lokal)
CLOUDFLARE_TUNNEL_TOKEN=
# SUPABASE_DB_URL=
# BACKUP_ENCRYPTION_KEY=

# Worker (opsional; semua punya default)
# WORKER_POLL_INTERVAL_MS=5000
# WORKER_BATCH_SIZE=3
# WORKER_MAX_ATTEMPTS=2
# WORKER_CLEANUP_INTERVAL_MS=3600000
# WORKER_PLAN_INTERVAL_MS=900000
# WORKER_ONCE=false

# Local Runner (Phase 2 M2.1)
RUNNER_SERVER_URL=http://localhost:3000
RUNNER_TOKEN=
RUNNER_SCRAPE_LIMIT_PER_PLATFORM=10
RUNNER_SCRAPE_DELAY_MIN_MS=20000
RUNNER_SCRAPE_DELAY_MAX_MS=45000
RUNNER_BROWSER_PROFILES_DIR=./browser-profiles
RUNNER_DEBUG_HTML_DIR=./data/runner-debug
RUNNER_HEADLESS=true
