# ---------------------------------------------------------------------------
# Salin menjadi `.env` (root, untuk worker) dan `apps/web/.env.local`
# (dimuat Next.js). Jangan commit nilai asli.
# ---------------------------------------------------------------------------

# Aplikasi
NODE_ENV=development
APP_URL=http://localhost:3000

# Supabase (project: ktdpqfxdnlyryvsdwnh)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Hanya untuk server (Route Handlers, Server Actions, worker). Jangan pernah
# dikirim ke browser.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Registrasi terbuka (internal). Set false untuk mode undangan.
REGISTRATION_ENABLED=true

# AI / Ollama (Phase 1 M3)
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_MS=180000
CV_AI_CONSENT_VERSION=2026-11-06.v1

# Penyimpanan file lokal
CV_STORAGE_DIR=./data/cv
RESUME_STORAGE_DIR=./data/resumes
