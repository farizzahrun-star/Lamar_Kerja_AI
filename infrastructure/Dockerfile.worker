# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.20.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/db/package.json ./packages/db/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/runner/package.json ./apps/runner/package.json
COPY workers/package.json ./workers/package.json
RUN pnpm install --frozen-lockfile --filter @lamarkerja/workers...

FROM deps AS runner
ENV NODE_ENV=production

RUN mkdir -p /data/cv && chown -R node:node /data

COPY --chown=node:node package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY --chown=node:node packages/db ./packages/db
COPY --chown=node:node packages/shared ./packages/shared
COPY --chown=node:node workers ./workers

USER node

CMD ["./workers/node_modules/.bin/tsx", "workers/src/index.ts"]
